generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContentType {
  id         Int                @id @default(autoincrement())
  name       String             @unique
  editable   Boolean            @default(true)
  components ContentComponent[]

  @@map("content_types")
}

model ContentComponent {
  id            Int                @id @default(autoincrement())
  name          String
  contentTypeId Int
  contentType   ContentType        @relation(fields: [contentTypeId], references: [id])
  fields        ComponentField[]
  instances     ComponentInstance[]

  @@unique([name, contentTypeId])
  @@map("content_components")
}

model ComponentField {
  id                 Int                          @id @default(autoincrement())
  name               String
  type               String                       @default("simple")
  contentComponentId Int
  contentComponent   ContentComponent             @relation(fields: [contentComponentId], references: [id])
  values             ComponentFieldValue[]
  instanceValues     ComponentInstanceFieldValue[]

  @@unique([name, contentComponentId])
  @@map("component_fields")
}

model ComponentFieldValue {
  id               Int                @id @default(autoincrement())
  value            String?
  type             String             @default("string")
  componentFieldId Int
  componentField   ComponentField     @relation(fields: [componentFieldId], references: [id])
  instanceId       Int?
  instance         ComponentInstance? @relation(fields: [instanceId], references: [id])

  @@map("component_field_values")
}

model ComponentInstance {
  id                  Int                          @id @default(autoincrement())
  templateComponentId Int
  templateComponent   ContentComponent             @relation(fields: [templateComponentId], references: [id])
  fieldValues         ComponentInstanceFieldValue[]
  referencedBy        ComponentFieldValue[]

  @@map("component_instances")
}

model ComponentInstanceFieldValue {
  id         Int               @id @default(autoincrement())
  value      String?
  instanceId Int
  instance   ComponentInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  fieldId    Int
  field      ComponentField    @relation(fields: [fieldId], references: [id])

  @@map("component_instance_field_values")
}

enum PartyStatus {
  pending
  confirmed
  cancelled
}

enum ContractStatus {
  draft
  pending
  in_review
  signed
  completed
  cancelled
}

model Customer {
  id        Int      @id @default(autoincrement())
  cpf       String   @unique
  name      String
  email     String?
  phone     String?
  parties   Party[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

model ContractTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  body      String
  variables String[]
  parties   Party[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contract_templates")
}

model Party {
  id                 Int              @id @default(autoincrement())
  customerId         Int
  customer           Customer         @relation(fields: [customerId], references: [id])
  contractTemplateId Int
  contractTemplate   ContractTemplate @relation(fields: [contractTemplateId], references: [id])
  date               DateTime
  dateEnd            DateTime?
  status             PartyStatus      @default(pending)
  contract           Contract?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("parties")
}

model Contract {
  id                  Int            @id @default(autoincrement())
  partyId             Int            @unique
  party               Party          @relation(fields: [partyId], references: [id])
  body                String
  fieldValues         Json
  status              ContractStatus @default(draft)
  clientToken         String?        @unique
  clientLinkOpen      Boolean        @default(false)
  docusignEnvelopeId  String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("contracts")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}
