generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContentType {
  id         Int                @id @default(autoincrement())
  name       String             @unique
  editable   Boolean            @default(true)
  components ContentComponent[]

  @@map("content_types")
}

model ContentComponent {
  id            Int                @id @default(autoincrement())
  name          String
  contentTypeId Int
  contentType   ContentType        @relation(fields: [contentTypeId], references: [id])
  fields        ComponentField[]
  instances     ComponentInstance[]

  @@unique([name, contentTypeId])
  @@map("content_components")
}

model ComponentField {
  id                 Int                          @id @default(autoincrement())
  name               String
  type               String                       @default("simple")
  contentComponentId Int
  contentComponent   ContentComponent             @relation(fields: [contentComponentId], references: [id])
  values             ComponentFieldValue[]
  instanceValues     ComponentInstanceFieldValue[]

  @@unique([name, contentComponentId])
  @@map("component_fields")
}

model ComponentFieldValue {
  id               Int                @id @default(autoincrement())
  value            String?
  type             String             @default("string")
  componentFieldId Int
  componentField   ComponentField     @relation(fields: [componentFieldId], references: [id])
  instanceId       Int?
  instance         ComponentInstance? @relation(fields: [instanceId], references: [id])

  @@map("component_field_values")
}

model ComponentInstance {
  id                  Int                          @id @default(autoincrement())
  templateComponentId Int
  templateComponent   ContentComponent             @relation(fields: [templateComponentId], references: [id])
  fieldValues         ComponentInstanceFieldValue[]
  referencedBy        ComponentFieldValue[]

  @@map("component_instances")
}

model ComponentInstanceFieldValue {
  id         Int               @id @default(autoincrement())
  value      String?
  instanceId Int
  instance   ComponentInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  fieldId    Int
  field      ComponentField    @relation(fields: [fieldId], references: [id])

  @@map("component_instance_field_values")
}

enum PartyStatus {
  pending
  confirmed
  cancelled
}

enum ContractStatus {
  draft
  pending
  in_review
  signed
  completed
  cancelled
}

enum PartyPaymentOption {
  salon_only
  salon_and_passports
}

enum GuestType {
  child
  adult
}

model Customer {
  id        Int      @id @default(autoincrement())
  cpf       String   @unique
  name      String
  email     String?
  phone     String?
  parties   Party[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

model ContractTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  body      String
  variables String[]
  isDefault Boolean  @default(false)
  parties   Party[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contract_templates")
}

model Party {
  id                      Int                 @id @default(autoincrement())
  customerId              Int
  customer                Customer            @relation(fields: [customerId], references: [id])
  contractTemplateId      Int
  contractTemplate        ContractTemplate    @relation(fields: [contractTemplateId], references: [id])
  date                    DateTime
  dateEnd                 DateTime?
  status                  PartyStatus         @default(pending)
  contract                Contract?
  childrenCount           Int?
  adultsCount             Int?
  totalParticipants       Int?
  paymentOption           PartyPaymentOption?
  salonPrice              Decimal?            @db.Decimal(10, 2)
  passportPackagePrice    Decimal?            @db.Decimal(10, 2)
  passportSinglePrice     Decimal?            @db.Decimal(10, 2)
  passportSingleCount     Int?
  totalPrice              Decimal?            @db.Decimal(10, 2)
  termsAcceptedAt         DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  guests                  Guest[]

  @@map("parties")
}

model Guest {
  id        Int       @id @default(autoincrement())
  partyId   Int
  party     Party     @relation(fields: [partyId], references: [id])
  name      String
  type      GuestType
  createdAt DateTime  @default(now())

  @@map("guests")
}

model Contract {
  id                  Int            @id @default(autoincrement())
  partyId             Int            @unique
  party               Party          @relation(fields: [partyId], references: [id])
  body                String
  fieldValues         Json
  status              ContractStatus @default(draft)
  clientToken         String?        @unique
  clientLinkOpen      Boolean        @default(false)
  docusignEnvelopeId  String?
  sentAt              DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("contracts")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Service {
  id           Int      @id @default(autoincrement())
  key          String?  @unique
  name         String
  weekdayPrice Decimal  @db.Decimal(10, 2)
  weekendPrice Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("services")
}

enum UserRole {
  admin
  operator
}

model User {
  id        String   @id
  email     String   @unique
  name      String?
  role      UserRole @default(operator)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkedInOrders  TicketOrder[] @relation("CheckedInBy")
  checkedOutOrders TicketOrder[] @relation("CheckedOutBy")

  @@map("users")
}

enum TicketOrderStatus {
  pending_payment
  paid
  payment_failed
  cancelled
  checked_in
  checked_out
}

model PassportType {
  id                    String   @id @default(cuid())
  name                  String
  durationMinutes       Int
  weekdayChildPrice     Decimal  @db.Decimal(10, 2)
  weekendChildPrice     Decimal  @db.Decimal(10, 2)
  weekdayCompanionPrice Decimal  @db.Decimal(10, 2)
  weekendCompanionPrice Decimal  @db.Decimal(10, 2)
  active                Boolean  @default(true)
  sort                  Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  ticketChildren   TicketChild[]
  ticketCompanions TicketCompanion[]

  @@map("passport_types")
}

model TicketOrder {
  id        String            @id @default(cuid())
  shortCode String            @unique
  status    TicketOrderStatus @default(pending_payment)

  guardianName     String
  guardianEmail    String
  guardianPhone    String
  guardianWhatsapp String

  totalAmount Decimal @db.Decimal(10, 2)

  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId   String?
  paidAt                  DateTime?

  contractedDurationMinutes Int?
  checkedInAt               DateTime?
  checkedInById             String?
  checkedInBy               User?     @relation("CheckedInBy", fields: [checkedInById], references: [id])
  checkedOutAt              DateTime?
  checkedOutById            String?
  checkedOutBy              User?     @relation("CheckedOutBy", fields: [checkedOutById], references: [id])
  overtimeMinutes           Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children   TicketChild[]
  companions TicketCompanion[]

  @@map("ticket_orders")
}

model TicketChild {
  id             String       @id @default(cuid())
  orderId        String
  order          TicketOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name           String
  birthDate      DateTime
  passportTypeId String
  passportType   PassportType @relation(fields: [passportTypeId], references: [id])
  isPNE          Boolean      @default(false)
  unitPrice      Decimal      @db.Decimal(10, 2)

  hasCompanion                 Boolean?
  unaccompaniedTermsAcceptedAt DateTime?

  createdAt DateTime @default(now())

  companion TicketCompanion?

  @@map("ticket_children")
}

model TicketCompanion {
  id      String      @id @default(cuid())
  orderId String
  order   TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name    String
  phone   String?

  isFree        Boolean      @default(false)
  linkedChildId String?      @unique
  linkedChild   TicketChild? @relation(fields: [linkedChildId], references: [id])

  passportTypeId String?
  passportType   PassportType? @relation(fields: [passportTypeId], references: [id])
  unitPrice      Decimal       @db.Decimal(10, 2) @default(0)

  createdAt DateTime @default(now())

  @@map("ticket_companions")
}
