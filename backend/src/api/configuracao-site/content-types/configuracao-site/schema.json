    },
    "instagram_url": {
      "type": "string",
      "default": "https://www.instagram.com/divercity.park"
    },
    "instagram_access_token": {
      "type": "string"
    },
    "google_places_api_key": {
      "type": "string"
    },
    "google_place_id": {
      "type": "string"
    },
    "endereco": {
      "type": "string",
      "default": "Av. Tuiuti, 710 – Gleba Patrimônio Maringa, Maringá 87043-720"
    },
    "horario_semana": {
      "type": "string",
      "default": "das 10h às 22h"
    },
    "horario_feriado": {
      "type": "string",
      "default": "das 12h às 20h"
    },
    "google_maps_url": {
      "type": "string"
    },
    "hero": {
      "type": "component",
      "component": "geral.hero",
      "repeatable": false
    },
    "benefitSection": {
      "type": "component",
      "component": "geral.attraction-section",
      "repeatable": false
    },
    "partySection": {
      "type": "component",
      "component": "geral.party-section",
      "repeatable": false
    },
    "priceSection": {
      "type": "component",
      "component": "geral.price-section",
      "repeatable": false
    },
    "contactSection": {
      "type": "component",
      "component": "geral.contact-section",
      "repeatable": false
    },
    "googleMapsUrlIframe": {
      "type": "string"
    },
    "logoFooter": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
