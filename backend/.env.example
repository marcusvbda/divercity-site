HOST=0.0.0.0
PORT=1337

# Keys — run `openssl rand -base64 32` to generate each
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
JWT_SECRET=changeme
ENCRYPTION_KEY=changeme

# Database (local SQLite — no changes needed)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Database (production PostgreSQL — uncomment for cloud)
# DATABASE_CLIENT=postgres
# DATABASE_HOST=your-host
# DATABASE_PORT=5432
# DATABASE_NAME=divercity
# DATABASE_USERNAME=your-user
# DATABASE_PASSWORD=your-password
# DATABASE_SSL=true
