# ═══════════════════════════════════════════════════════════════════════════════
# SUPABASE — banco de dados + autenticação
# Dashboard: https://supabase.com/dashboard/project/<project-ref>
# ═══════════════════════════════════════════════════════════════════════════════

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Runtime queries — transaction-mode pooler (porta 6543, PgBouncer)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations only — session-mode pooler (porta 5432, sem pgbouncer)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"


# ═══════════════════════════════════════════════════════════════════════════════
# NEXTAUTH — autenticação da área admin (/admin)
# Gerar secret: openssl rand -base64 32
# ═══════════════════════════════════════════════════════════════════════════════

NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000


# ═══════════════════════════════════════════════════════════════════════════════
# OUTROS
# ═══════════════════════════════════════════════════════════════════════════════

# Segredo para rotas de revalidação on-demand (ISR)
REVALIDATE_SECRET=your-revalidate-secret

# Instagram e Google são configurados via /admin/settings (banco de dados)

# ───────────────────────────────────────────────────────────────────────────────
# Google Places API — avaliações exibidas na seção Depoimentos
# Como obter: console.cloud.google.com → APIs & Services → Credentials → API Key
# Ativar: Places API (Legacy) — place/details + place/findplacefromtext
GOOGLE_PLACES_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_PLACE_ID=ChIJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Rating mínimo para exibir (1–5). Padrão: 4
GOOGLE_TESTIMONIALS_MINIMUM_RATING=4


# ═══════════════════════════════════════════════════════════════════════════════
# DOCUSIGN — assinatura digital de contratos
# Docs: https://developers.docusign.com/
# ═══════════════════════════════════════════════════════════════════════════════

DOCUSIGN_INTEGRATION_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DOCUSIGN_ACCOUNT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DOCUSIGN_USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Chave RSA privada — gerar: openssl genrsa -out private.pem 2048 && cat private.pem | base64 -w 0
DOCUSIGN_PRIVATE_KEY_BASE64=

# Sandbox: https://demo.docusign.net/restapi | Produção: https://na4.docusign.net/restapi
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi

# Sandbox: account-d.docusign.com | Produção: account.docusign.com
DOCUSIGN_OAUTH_BASE_PATH=account-d.docusign.com

NEXT_PUBLIC_APP_URL=http://localhost:3000
