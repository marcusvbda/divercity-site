# ═══════════════════════════════════════════════════════════════════════════════
# SUPABASE — banco de dados + autenticação
# Dashboard: https://supabase.com/dashboard/project/<project-ref>
# ═══════════════════════════════════════════════════════════════════════════════

# URL do projeto (sem /rest/v1/) — usada pelo SDK server-side
SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key — segura para client components (NEXT_PUBLIC_*)
# Settings → API → Project API keys → Publishable
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ─── Prisma / PostgreSQL ──────────────────────────────────────────────────────

# Runtime queries — transaction-mode pooler (IPv4, porta 6543, PgBouncer)
# Settings → Database → Connection string → Transaction
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations only — session-mode pooler (porta 5432, sem pgbouncer)
# Settings → Database → Connection string → Session
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"


# ═══════════════════════════════════════════════════════════════════════════════
# NEXTAUTH — autenticação da área admin (/admin)
# ═══════════════════════════════════════════════════════════════════════════════

# Gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000


# ═══════════════════════════════════════════════════════════════════════════════
# OUTROS
# ═══════════════════════════════════════════════════════════════════════════════

# Instagram Graph API — token de longa duração (~60 dias)
# Sem token, o carrossel exibe imagens placeholder automaticamente
# Como obter: developers.facebook.com → App → Instagram Graph API → Long-lived token
INSTAGRAM_ACCESS_TOKEN=


# ═══════════════════════════════════════════════════════════════════════════════
# STRAPI CMS — legado (será removido após migração completa para Supabase)
# ═══════════════════════════════════════════════════════════════════════════════

STRAPI_URL=https://<seu-projeto>.strapiapp.com
STRAPI_API_TOKEN=
