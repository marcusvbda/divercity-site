# ÚNICO token necessário no .env — tudo mais vem do CMS
# Gerar em: Strapi Admin > Settings > API Tokens > Full Access
# NUNCA commitar o valor real
STRAPI_URL=https://supportive-benefit-62bd36c47a.strapiapp.com
STRAPI_API_TOKEN=

# As credenciais abaixo NÃO ficam no .env — ficam no CMS:
#   Strapi Admin > Configuração do Site > instagram_access_token
#   Strapi Admin > Configuração do Site > google_places_api_key
#   Strapi Admin > Configuração do Site > google_place_id


# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=***

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=***